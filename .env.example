# Cuba Dashboard — Environment Variables
# Copy to .env.local and fill in your keys

# ─── Required for AI features ────────────────────────────────────────────────

# Anthropic — powers the AI chatbot + power article filtering
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Recommended ─────────────────────────────────────────────────────────────

# AISstream.io — free API key for maritime vessel tracking
# Get a key at: https://aisstream.io
AISSTREAM_API_KEY=

# ─── Optional (extra data sources) ───────────────────────────────────────────

# AirLabs — aircraft tracking fallback (1000 calls/month free)
# Get a key at: https://airlabs.co
AIRLABS_API_KEY=

# Mediastack — additional news coverage (100 requests/month free)
# Get a key at: https://mediastack.com
MEDIASTACK_API_KEY=

# GNews — additional news coverage (100 requests/day free)
# Get a key at: https://gnews.io
GNEWS_API_KEY=

# Currents API — additional news coverage (600 requests/day free)
# Get a key at: https://currentsapi.services
CURRENTS_API_KEY=

# Cuba power grid scraper URL (optional)
# Point to your custom scraper endpoint that returns province status data
CUBA_POWER_SCRAPER_URL=

# ─── No keys needed for ──────────────────────────────────────────────────────
# - Google News RSS (news) — free, unauthenticated
# - GDELT (news) — free, unauthenticated
# - OpenSky Network (aircraft) — free, unauthenticated
# - Polymarket Gamma API (predictions) — free, unauthenticated
