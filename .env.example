# Cuba Dashboard — Environment Variables
# Copy to .env.local and fill in your keys

# AISstream.io — free API key for maritime vessel tracking
# Get a key at: https://aisstream.io
AISSTREAM_API_KEY=

# Mediastack — API key for additional news coverage
# Get a free key at: https://mediastack.com (100 requests/month free)
MEDIASTACK_API_KEY=

# Cuba power grid scraper URL (optional)
# Point to your custom scraper endpoint that returns province status data
# No public API exists for UNE (Cuba's electric utility)
CUBA_POWER_SCRAPER_URL=

# No keys needed for:
# - GDELT (news) — free, unauthenticated
# - OpenSky Network (aircraft) — free, unauthenticated
# - Polymarket Gamma API (predictions) — free, unauthenticated
